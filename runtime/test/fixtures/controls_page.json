{
  "document": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><link rel=\"icon\" href=\"data:,\"><title>controls_page</title><script type=\"module\" src=\"/_hypersig/runtime.js\"></script></head><body data-hs-signals=\"{&quot;gift&quot;:false,&quot;limit&quot;:null,&quot;note&quot;:&quot;gift wrap&quot;,&quot;price&quot;:2.5,&quot;quantity&quot;:1,&quot;size&quot;:&quot;Small&quot;}\"><main><input id=\"quantity\" type=\"number\" value=\"1\" data-hs-bind=\"[&quot;quantity&quot;,&quot;int&quot;]\"><input id=\"price\" type=\"number\" value=\"2.5\" data-hs-bind=\"[&quot;price&quot;,&quot;float&quot;]\"><select id=\"size\" data-hs-bind=\"[&quot;size&quot;,&quot;json&quot;]\"><option selected=\"\" value=\"&quot;Small&quot;\">Small</option><option value=\"&quot;Large&quot;\">Large</option></select><input id=\"note\" value=\"gift wrap\" data-hs-bind=\"[&quot;note&quot;,&quot;opt_text&quot;]\"><input id=\"limit\" type=\"number\" data-hs-bind=\"[&quot;limit&quot;,&quot;opt_int&quot;]\"><input id=\"small\" type=\"radio\" checked=\"\" data-hs-bind=\"[&quot;size&quot;,&quot;radio&quot;,&quot;Small&quot;]\"><input id=\"large\" type=\"radio\" data-hs-bind=\"[&quot;size&quot;,&quot;radio&quot;,&quot;Large&quot;]\"><button id=\"buy\" style=\"width: 1rem\" title=\"5.00\" data-hs-attr=\"[[&quot;title&quot;,[&quot;fixed&quot;,[&quot;mul&quot;,[&quot;sig&quot;,&quot;price&quot;],[&quot;lit&quot;,2.0]],2]]]\" data-hs-toggle=\"[[&quot;disabled&quot;,[&quot;le&quot;,[&quot;sig&quot;,&quot;quantity&quot;],[&quot;lit&quot;,0]]]]\" data-hs-style=\"[[&quot;width&quot;,[&quot;concat&quot;,[&quot;str&quot;,[&quot;sig&quot;,&quot;quantity&quot;]],[&quot;lit&quot;,&quot;rem&quot;]]]]\">Buy</button><span id=\"price-label\" data-hs-text=\"[&quot;format&quot;,[&quot;mul&quot;,[&quot;sig&quot;,&quot;price&quot;],[&quot;lit&quot;,1000.0]],2,&quot;,&quot;,&quot;.&quot;,&quot;$&quot;,&quot;&quot;]\">$2,500.00</span><span id=\"total\" data-hs-text=\"[&quot;if&quot;,[&quot;eq&quot;,[&quot;sig&quot;,&quot;size&quot;],[&quot;lit&quot;,&quot;Large&quot;]],[&quot;lit&quot;,&quot;large&quot;],[&quot;lit&quot;,&quot;small&quot;]]\">small</span></main></body></html>"
