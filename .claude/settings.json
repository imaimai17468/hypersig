{
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo run *)",
      "Bash(pnpm install)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "extraKnownMarketplaces": {
    "beautiful-rust": {
      "source": {
        "source": "github",
        "repo": "morganlinton/BeautifulRust"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "enabledPlugins": {
    "beautiful-rust@beautiful-rust": true,
    "yomiyasu@yomiyasu": true,
    "humanizer@humanizer": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-before-pr.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
